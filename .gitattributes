# Normalise line endings: LF in the repo and in every checkout (Mac and Windows).
# `eol=lf` overrides each machine's core.autocrlf, so no per-PC git config is needed.
* text=auto eol=lf

# Windows-only scripts must stay CRLF (e.g. Flutter's android/gradlew.bat).
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Unix scripts must stay LF or they break on Mac/Linux/CI.
*.sh    text eol=lf
gradlew text eol=lf

# Binary files: never touch line endings, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.jar   binary
*.keystore binary
*.jks   binary
*.so    binary
*.a     binary
*.zip   binary

# Generated binary fixtures (FEAT-002-T02): never touch line endings.
test_support/crop_fixtures/** binary
test_support/crop_fixtures/MANIFEST.md text eol=lf
